{
  "manifest_version": 3,
  "name": "WhatsApp Contacts Blur",
  "version": "1.0.0",
  "description": "Blur contacts in the WhatsApp Web chat list for privacy. Hover a contact to reveal it.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "WhatsApp Contacts Blur",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsapp-contacts-blur@example.com",
      "strict_min_version": "109.0"
    }
  }
}
